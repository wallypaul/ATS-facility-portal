# Copy to .env and point at your ATS API server root (no trailing slash, no path).
# Auth endpoints live under /user/..., portal endpoints under /api/payer/...
VITE_API_BASE=http://localhost:8000

# Google Maps JS API key for pickup/drop-off address autocomplete. Referrer-restrict
# it in the Google Cloud console to this portal's domain(s) — it ships in the client bundle.
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key
